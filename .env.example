# Copy to .env and fill in. Everything except SEC_USER_AGENT is optional.

# The SEC requires a name and contact email in the User-Agent of every EDGAR request.
SEC_USER_AGENT=YourAppName your-email@example.com

# Google AI Studio key: enables AI case summaries (without it, a plain template summary is used).
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite

# Stripe TEST-mode keys and the price ids of your Pro and Enterprise products.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
APP_URL=http://localhost:5174

# Production only: a long random secret for signing login tokens (32+ characters).
JWT_SECRET=
# Demo firm with one user per role; set SEED_DEMO=false in production.
SEED_DEMO=true
DEMO_PASSWORD=Sentinel#2026
